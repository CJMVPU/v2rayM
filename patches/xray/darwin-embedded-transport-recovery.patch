+// Count independent failures. Parallel A/AAAA queries from a single burst
+// must not retire a resolver. Late results from a drained pool are irrelevant.
+func (s *DoHNameServer) recordExchange(hc *http.Client, started time.Time, err error) {
+	s.clientMu.Lock()
+	if hc != s.httpClient {
+		s.clientMu.Unlock()
+		return
+	}
+	if err == nil {
+		s.firstTimeout = time.Time{}
+	} else if stderrors.Is(err, context.DeadlineExceeded) {
+		if s.firstTimeout.IsZero() {
+			s.firstTimeout = time.Now()
+		} else if started.After(s.firstTimeout) {
+			s.httpClient = s.newHTTPClient()
+			s.firstTimeout = time.Time{}
+			s.clientMu.Unlock()
+			hc.CloseIdleConnections()
+			errors.LogWarning(context.Background(), "renewing DoH transport after consecutive query timeouts: ", s.Name())
+			return
+		}
+	}
