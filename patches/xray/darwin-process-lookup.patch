+++ b/app/router/process_lookup_log.go
@@ -0,0 +1,49 @@
+package router
+
+import (
+	"context"
+	stderrors "errors"
+	"sync"
+	"time"
+
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+)
+
+type processLookupMissWindow struct {
+	mu    sync.Mutex
+	last  time.Time
+	count uint64
+}
+
+func (w *processLookupMissWindow) record(now time.Time) uint64 {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	w.count++
+	if !w.last.IsZero() && now.Sub(w.last) < time.Minute {
+		return 0
+	}
+	count := w.count
+	w.count = 0
+	w.last = now
+	return count
+}
+
+var processLookupMisses processLookupMissWindow
+
+func logProcessLookupFailure(err error) {
+	switch {
+	case stderrors.Is(err, net.ErrNotLocal):
+		return
+	case stderrors.Is(err, net.ErrProcessNotFound):
+		// Keep full per-flow diagnostics in debug logs, and a bounded visible
+		// warning. Never guess an owner or change the rule's no-match result.
+		errors.LogDebug(context.Background(), "Process owner unavailable; continuing routing rules: ", err)
+		if count := processLookupMisses.record(time.Now()); count != 0 {
+			errors.LogWarning(context.Background(), "Process owner unavailable for ", count,
+				" lookup(s) since last report; process rules did not match, continuing remaining routing rules. Further misses are aggregated for 60s; enable debug for each flow.")
+		}
+	default:
+		errors.LogError(context.Background(), "Unable to query local process: ", err)
+	}
+}
