+// DiagnosticStrategy uses a job-local observation and the same picker and thresholds
+// as the configured router, without registering a second observatory on the serving instance.
+func (br *BalancingRule) DiagnosticStrategy(ctx context.Context, observation extension.Observatory) (BalancingStrategy, error) {
+	balancer, err := br.Build(nil, nil)
+	if err != nil {
+		return nil, err
+	}
+	switch s := balancer.strategy.(type) {
+	case *LeastPingStrategy:
+		s.ctx, s.observatory = ctx, observation
+	case *LeastLoadStrategy:
+		s.ctx, s.observer = ctx, observation
+	}
+	return balancer.strategy, nil
 }
 
