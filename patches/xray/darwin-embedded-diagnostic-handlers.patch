+// AttachProbe exposes exact private tags for a local diagnostic and its detours.
+// They are never default outbounds, selector candidates, or listed handlers.
+// The caller starts and closes the handlers and detaches them before core shutdown.
+func (m *Manager) AttachProbe(handlers map[string]outbound.Handler) error {
+	m.access.Lock()
+	defer m.access.Unlock()
+	for tag := range handlers {
+		if tag == "" || m.taggedHandler[tag] != nil || m.probeHandlers[tag] != nil {
+			return errors.New("diagnostic handler tag collision")
+		}
+	}
+	for tag, handler := range handlers {
+		m.probeHandlers[tag] = handler
+	}
+	return nil
+}
+
+func (m *Manager) DetachProbe(handlers map[string]outbound.Handler) {
+	m.access.Lock()
+	defer m.access.Unlock()
+	for tag := range handlers {
+		delete(m.probeHandlers, tag)
+	}
 }
 
