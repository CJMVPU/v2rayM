+	c.poolMu.Lock()
+	defer c.poolMu.Unlock()
+	last := len(c.idleUploads) - 1
+	if last < 0 {
+		return nil
+	}
+	conn := c.idleUploads[last]
+	c.idleUploads[last] = nil
+	c.idleUploads = c.idleUploads[:last]
+	return conn
+}
+func (c *DefaultDialerClient) returnUpload(conn *H1Conn) {
+	c.poolMu.Lock()
+	if !c.closed.Load() && len(c.idleUploads) < 32 {
+		c.idleUploads = append(c.idleUploads, conn)
+		c.poolMu.Unlock()
+		return
+	}
+	c.poolMu.Unlock()
+	_ = conn.Close()
+}
