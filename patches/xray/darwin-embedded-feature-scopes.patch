 // MemoryStreamConfig is a parsed form of StreamConfig. It is used to reduce the number of Protobuf parses.
+type streamLifetime struct {
+	sync.Mutex
+	closed  bool
+	release map[string]func()
+}
+
+func (s *MemoryStreamConfig) TrackPooledTransport(key string, release func()) bool {
+	if s == nil || s.lifetime == nil {
+		return true
+	}
+	life := s.lifetime
+	life.Lock()
+	defer life.Unlock()
+	if life.closed {
+		return false
+	}
+	life.release[key] = release
+	return true
+}
+func (s *MemoryStreamConfig) ClosePooledTransports() {
+	if s == nil || s.lifetime == nil {
+		return
+	}
+	life := s.lifetime
+	life.Lock()
+	life.closed = true
+	release := life.release
+	life.release = nil
+	life.Unlock()
+	for _, close := range release {
+		close()
+	}
+}
