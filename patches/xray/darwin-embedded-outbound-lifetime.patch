+// Only one Xray instance serves the embedded host. Its process outlives every tunnel.
+var embeddedOutbound atomic.Pointer[InterfaceUpdater]
+
+func init() {
+	common.Must(internet.RegisterDialerController(bindEmbeddedOutbound))
+}
+
+func bindEmbeddedOutbound(network, address string, c syscall.RawConn) error {
+	active := embeddedOutbound.Load()
+	if active == nil {
+		return nil
+	}
+	iface := active.Get()
+	if iface == nil {
+		errors.LogInfo(context.Background(), "[tun] falied to set interface > iface == nil")
+		return errors.New("iface not found")
+	}
+	var controlErr, sockErr error
+	controlErr = c.Control(func(fd uintptr) {
+		addrPort, _ := netip.ParseAddrPort(address)
+		// skip loopback
+		if addrPort.Addr().IsLoopback() || strings.HasPrefix(strings.ToLower(address), "localhost:") {
+			return
+		}
+		err := setinterface(network, address, fd, iface)
+		if err != nil {
+			sockErr = errors.New("[tun] falied to set interface").Base(err)
+		}
+	})
+	if sockErr != nil {
+		return sockErr
+	}
+	return controlErr
+}
